# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption key for SMTP/IMAP passwords stored in DB (generate with: openssl rand -base64 32)
ENCRYPTION_KEY=your-32-char-random-key

# AI
OPENAI_API_KEY=your-openai-key
OPENAI_ASSISTANT_MODEL=gpt-4.1
OPENAI_EXTRACT_MODEL=gpt-4.1-mini
OPENAI_MEETING_MODEL=gpt-4.1
OPENAI_PERSONALIZE_MODEL=gpt-4.1
OPENAI_PROMPT_MODEL=gpt-4.1-mini
OPENAI_REPLY_MODEL=gpt-4.1
OPENAI_RESEARCH_MODEL=gpt-4.1-mini
OPENAI_SCORE_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
MISTRAL_API_KEY=your-mistral-key
MISTRAL_MODEL=mistral-small-latest
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key
GOOGLE_GENERATIVE_AI_MODEL=gemini-2.0-flash

# LangGraph launch agent model routing. Values may be plain model names or provider-prefixed specs:
# openai:gpt-4.1, anthropic:claude-sonnet-4-5-20250929, mistral:mistral-small-latest, google:gemini-2.0-flash
AGENT_MODEL_PROVIDER=openai
AGENT_ASSISTANT_MODEL=openai:gpt-4.1
AGENT_PROFILE_MODEL=openai:gpt-4.1-mini
AGENT_OUTREACH_MODEL=openai:gpt-4.1
AGENT_STATUS_MODEL=openai:gpt-4.1-mini
AGENT_SAFETY_MODEL=openai:gpt-4.1-mini

# Web research (https://linkup.so)
LINKUP_API_KEY=your-linkup-key

# Contact enrichment (https://fullenrich.com)
FULLENRICH_API_KEY=your-fullenrich-key

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Tracking (generate with: openssl rand -base64 32)
TRACKING_SECRET=your-hmac-tracking-secret

# App URL (used for tracking pixel, OAuth callbacks)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Internal cron/service calls
CRON_SECRET=your-cron-secret
GTM_AI_PREP_LIMIT=6

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
